# CampusLink environment configuration
# Copy this file to `.env` and adjust the values for your environment.

# Base URL of the CampusLink PHP backend (no trailing slash).
# - Android emulator:  http://10.0.2.2
# - iOS simulator:     http://localhost
# - Physical device:   http://<your-computer-local-ip>
API_BASE_URL=http://10.0.2.2

# Base URL of the fingerprint (NodeMCU) attendance device server.
NODE_URL=http://192.168.1.77

# Google Gemini API key for the campus chatbot.
GEMINI_API_KEY=
