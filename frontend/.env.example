# CampusLink frontend environment configuration
# Copy this file to `.env` and adjust values per environment.

# Base URL of the CampusLink backend (Node.js API on Render).
# - Local backend:       http://10.0.2.2:3000   (Android emulator)
# - iOS simulator:       http://localhost:3000
# - Production (Render): https://<your-service>.onrender.com
API_BASE_URL=http://10.0.2.2:3000

# NOTE: the Gemini API key is configured on the BACKEND (Render env vars),
# never in the app — see backend/.env.example.
