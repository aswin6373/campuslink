# CampusLink backend environment
# Copy to .env for local development; on Render use the dashboard env vars.

# Supabase Postgres connection string.
# Supabase Dashboard -> Project Settings -> Database -> Connection string ->
# "Transaction pooler" (port 6543). Append ?sslmode=require
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Secret for signing JWTs. Generate: openssl rand -hex 32
JWT_SECRET=change-me

# Shared secret the NodeMCU must send as the "x-device-key" header.
# Generate: openssl rand -hex 16
DEVICE_API_KEY=change-me

# A device counts as "connected" for this many minutes after its last heartbeat.
DEVICE_OFFLINE_MINUTES=2
